# Copy to .env.local for Next.js development. Never commit .env.local.

# Server-only. Never add NEXT_PUBLIC_ to these values.
AI_RATE_LIMIT_SALT=
OPENROUTER_API_KEY=
# Stable production default for the live coach. openrouter/free is testing-only.
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3000
APP_TITLE=FitLifeHub
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Replace the support and operator examples before publishing.
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_LEGAL_NAME=Your legal business name
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE=2026-08-12

# Optional analytics.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
